        {
          "titulo": "Por escrito",
          "texto": "Tu contrato debe quedar por escrito dentro de 15 días desde que empiezas, o de 5 días si es por una obra o dura menos de 30 días.",
          "fuentes": [
            {
              "archivo": "Código del Trabajo",
              "articulo": "Art. 9 CT",
              "fueraDelMaterial": true
            }
          ],
          "revisar": false
        },
        {
          "titulo": "Dos copias",
          "texto": "Se firma en dos copias: una para ti y otra para tu empleador. Guarda siempre la tuya.",
          "fuentes": [
            {
              "archivo": "Código del Trabajo",
              "articulo": "Art. 9 CT",
              "fueraDelMaterial": true
            }
          ],
          "revisar": false
        },
